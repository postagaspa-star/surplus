<?xml version="1.0" encoding="utf-8"?>
<!-- Stessa regola della versione precedente di Android: la chiave dell'utente
     non esce dal telefono, né via backup cloud né via trasferimento a un altro
     dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
