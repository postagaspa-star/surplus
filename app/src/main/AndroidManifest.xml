<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Promemoria spuntini: notifiche + sveglie esatte agli orari scelti dall'utente.
         App distribuita via sideload (non Play Store), quindi USE_EXACT_ALARM è ok. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Rete per la ricerca alimenti su Open Food Facts e, SOLO se l'utente ha
         messo una propria chiave, per il riconoscimento della foto: in quel caso
         parte la singola foto scelta, nient'altro del diario. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fotocamera per il codice a barre e per la foto del piatto. Gli scatti
         restano nella cache privata dell'app finché non li si usa. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- L'app si aggiorna da sola prendendo la versione nuova dal NAS di casa.
         Android accetta solo un aggiornamento firmato con la stessa chiave di
         questa app, quindi nessun altro puo' sostituirla. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SurplusApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/sicurezza_rete"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Surplus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surplus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".aggiornamento.AggiornamentoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="it.gaspa.surplus.ESITO_INSTALLAZIONE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Permette alla fotocamera di scrivere lo scatto nella cache dell'app
             senza dare accesso al resto dei file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
