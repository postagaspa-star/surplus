<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Surplus</RootNamespace>
    <AssemblyName>Surplus</AssemblyName>
    <AssemblyTitle>Surplus</AssemblyTitle>
    <Product>Surplus</Product>
    <Version>1.1.4</Version>
    <FileVersion>1.1.4.0</FileVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <!-- Il pacchetto WebView2 si porta dietro anche la parte WPF, che qui non si usa. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <Import Project="Pubblicazione.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Surplus.Tests" />
  </ItemGroup>

  <!--
    L'interfaccia sta in pc/ui: si copia nella cartella ui accanto a Surplus.exe e
    viaggia anche dentro l'exe (se manca accanto, Installazione.AssicuraUi la estrae).
  -->
  <PropertyGroup>
    <SurplusCartellaUi>$(MSBuildProjectDirectory)\..\ui\</SurplusCartellaUi>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(SurplusCartellaUi)**\*" LinkBase="ui" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="$(SurplusCartellaUi)**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
