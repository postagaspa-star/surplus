<Project>
  <!--
    bin/ e obj/ fuori da OneDrive: il Desktop è sincronizzato, e OneDrive che
    blocca un file mentre lo carica fa fallire la build a caso ("file in uso").
    Il pacchetto finale resta in pc/dist (prove/crea-pacchetto.ps1).
  -->
  <PropertyGroup>
    <SurplusCartellaBuild>$(LOCALAPPDATA)\Surplus-pc\build\</SurplusCartellaBuild>
    <BaseIntermediateOutputPath>$(SurplusCartellaBuild)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(SurplusCartellaBuild)$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
